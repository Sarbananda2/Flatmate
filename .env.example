# Local settings for the Apartment Expense Manager.
#
# Copy this file to .env.local (which Git ignores) and adjust it. Both the app
# and the scripts read .env.local; a variable already set in the environment
# always wins, so a deployment needs no file at all.
#
# Never commit a real password.

# --- Where the database is -------------------------------------------------
# The defaults below are the project's local development cluster.
AEM_DB_HOST=127.0.0.1
AEM_DB_PORT=55432
AEM_DB_NAME=aem
AEM_DB_USER=aem
# The runtime role: what the application serves requests as. It owns nothing
# and cannot change the schema; it is granted row-level access to the tables.
# Leave the password out on a fresh checkout: ./scripts/dev.sh generates one and
# appends it to .env.local the first time it creates the cluster.
# AEM_DB_PASSWORD=

# The migration role: owns the database and its tables. Used only by
# "manage.py init", "import-sqlite", "restore", and the test setup. A host
# that only serves the app does not need this password and should not have it.
# Generated into .env.local on first run, like the one above.
AEM_DB_MIGRATION_USER=aem_owner
# AEM_DB_MIGRATION_PASSWORD=

# For a remote PostgreSQL endpoint (for example in AWS), set the host, name,
# user and password above, or give one URL instead, and require TLS:
# AEM_DATABASE_URL=postgresql://aem:PASSWORD@your-endpoint.rds.amazonaws.com:5432/aem
# AEM_MIGRATION_DATABASE_URL=postgresql://aem_owner:PASSWORD@your-endpoint.rds.amazonaws.com:5432/aem
# AEM_DB_SSLMODE=verify-full
# AEM_DB_SSLROOTCERT=/path/to/global-bundle.pem

# --- The local cluster only (scripts/dev.sh, scripts/local_postgres.sh) -----
# Override the local cluster's listener port independently of a remote
# AEM_DB_PORT setting. Default: 55432.
# AEM_PG_PORT=55432
# The bin directory of a PostgreSQL 18 installation. Needed unless PostgreSQL
# 18's programs are already on PATH or in a standard location.
# AEM_PG_BIN_DIR=/usr/lib/postgresql/18/bin
# Where the cluster keeps its files. Default: ./data/postgres
# AEM_PG_DATA_DIR=data/postgres
# The cluster's bootstrap administrator (its superuser). Only
# scripts/local_postgres.sh uses it, to create the two roles above and the
# databases. The application never reads these. The password is generated into
# .env.local on first run, like the one above.
# AEM_PG_ADMIN_USER=aem_admin
# AEM_PG_ADMIN_PASSWORD=
# The database the test suite uses. Default: <AEM_DB_NAME>_test
# AEM_TEST_DB_NAME=aem_test
