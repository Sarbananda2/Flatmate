# Application data. The database is the household's real accounts; it is never
# committed, and neither are its backups. data/postgres/ is the local
# PostgreSQL cluster.
data/
backups/
*.dump

# Local settings and secrets (the database password lives here).
.env
.env.local
.env.*.local
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
frontend/dist/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Local deployment and maintenance scripts
deploy/audit_aws_resources.sh
deploy/cleanup_*.sh
deploy/link_custom_domain.sh
deploy/setup_*.sh
