# Production environment configuration.
# Copy this file to .env on the server (cp .env.production.example .env) and
# replace every placeholder. Generate each password with:
#     openssl rand -base64 24 | tr -d '/+='
# Never commit the real .env.

# The domain or subdomain whose DNS A record points at the server's static IP
# (e.g. expenses.example.com). Caddy obtains a free Let's Encrypt certificate for it.
DOMAIN=expenses.yourdomain.com

# PostgreSQL. Three separate roles, each with its own password:
#   the administrator sets the database up on first start and is not used after;
#   the migration role owns the schema and applies migrations when the app starts;
#   the runtime role is what the app serves requests as, and can change no table.
AEM_DB_NAME=aem
AEM_PG_ADMIN_USER=aem_admin
AEM_PG_ADMIN_PASSWORD=replace-with-a-generated-password
AEM_DB_MIGRATION_USER=aem_owner
AEM_DB_MIGRATION_PASSWORD=replace-with-another-generated-password
AEM_DB_USER=aem
AEM_DB_PASSWORD=replace-with-a-third-generated-password

# Amazon S3 bucket for the nightly backups (optional, recommended).
# deploy/backup_to_s3.sh uploads each dump to s3://<bucket>/aem-backups/.
AEM_S3_BACKUP_BUCKET=my-apartment-expense-backups
